# Server only. Never prefix these keys with VITE_ or put them in browser code.
# Local npm run dev:online works without these using .local-rooms/.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-in-server-environment-only
# Legacy alternative (JWT service_role); use one key configuration only:
# SUPABASE_SERVICE_ROLE_KEY=replace-in-server-environment-only
# ROOM_DATA_DIR=.local-rooms
