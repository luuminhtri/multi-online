{
  "name": "ma-soi-multi-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "demo": "node examples/night.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:data": "python3 -m unittest discover -s tests -p 'test_*.py' && python3 beauti.py --check",
    "gen:images": "node scripts/generate-role-images.mjs",
    "dev:online": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "debug": "vite --host 0.0.0.0 --port 5174 --strictPort --mode debug",
    "gen:descriptions": "node scripts/generate-role-descriptions.mjs",
    "test:players": "node scripts/open-test-players.mjs",
    "build:ios": "npm run typecheck && vite build --mode ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "test:ios-shell": "npm run build:ios && node scripts/test-iphone-shell.mjs",
    "test:ios-reconnect": "npm run build:ios && node scripts/test-iphone-reconnect.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.18.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  }
}
